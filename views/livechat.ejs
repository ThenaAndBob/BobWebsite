<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href='https://fonts.googleapis.com/css?family=Dangrek' rel='stylesheet'>
    <link rel="stylesheet" href="/banner.css">
    <link rel="icon" href="https://bobsboosting.com/favicon.ico" type="image/x-icon">
    <link rel="shortcut icon" href="https://bobsboosting.com/favicon.ico" type="image/x-icon">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-L5ELYSX1G0">
    </script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-L5ELYSX1G0');
    </script>
    <title>Bob's Boosting Chat</title>
    
    <style>
        body {
            background-image: url("https://i.imgur.com/fEDLZo9.png");
            background-repeat: no-repeat;
            background-attachment: fixed;
            background-size: cover;
            background-color: black;
        }

        .container {
            position: absolute;
            top:0px;
            left:0px;
            width:100%;
            height: 100vh;
            color: #d29c4b;
            display: flex;
            text-align: center;
            flex-wrap: wrap;
            justify-content: center;
            font-family: sans-serif;
        }

        .boostdetails {
            position: relative;
            top: 100px; 
            width:30%;
            height:70%;
            backdrop-filter: blur(15px);
            margin: 50px;
            flex-wrap: nowrap;
            margin-right: 60px;
            border: 5px solid #d29c4b;
            border-radius: 10px;
            }

        .chat{
            position: relative;
            top: 100px;
            width:55%;
            height:70%;
            margin: 50px;
            display: flex;
            justify-content: flex-end;
            flex-direction: column;
            border: 5px solid #d29c4b;
            border-radius: 10px;
            backdrop-filter: blur(15px);
        }

        .scrollmessages {
            margin-top: 2%;
            margin-left: 5%;
            width: 90%;
            height: 100%;
            overflow: auto;
            text-align: justify;
            font-size: 17px;
            color: white;
        }

        .form {
            text-align: center;
            width: 90%;
            position: relative;
            left: 5%;
        }   

        .form input {
            width: 94%;
            padding: 7px;
            border: 2px solid #d29c4b;
            border-radius: 5px;
            margin: 15px 0px;
            background-color: #04131d;
            color: white;
            font-size: 15px;
        }

        .sender {
            font-size: 20px;
            font-family: sans-serif
        }

        .content {
            font-size: 15px;
            font-family: sans-serif
        }

        .btitle{
            font-size: 50px;
            margin: 15px;
        }

        .rankimage{
            aspect-ratio: 1/1;
            width: 100%;
            vertical-align: middle;
        }

        .startend{
            width:100%;
            flex-wrap: nowrap;
            display: flex;
            margin: 0px;
            align-items: center;
        }

        .orderID{
            color: white;
        }

        .arrow{
            width: 50%;
            height: 10%;
            position: relative;
        }

        .caption{
            font-size: 25px;
            font-weight: bold;
            font-family: 'Times New Roman', Times, serif;
        }


    </style>
</head>

<body>
    <div class="container">
        <div class="banner l" id="banner">
            <a class="nodec" href="https://bobsboosting.com">Home</a> 
            <a class="nodec" href="https://bobsboosting.com/login">Login</a>
            <a class="nodec" href="https://discord.gg/uvJRspbxuB">Discord</a> 
            <a class="nodec" href="https://bobsboosting.com/FAQ">FAQ</a>
        </div>
        <div class="boostdetails" id="boostinfo">
            <div class="btitle" id="btitle">Thank you for choosing Bob's Boosting!</div>
            <div class="orderID">Your Order ID: <b>AA089GU08AGUAW0</b></div><br><br><br>
            <div class="startend">

                <span>
                    <img src="https://i.imgur.com/iltHUX5.png" class="rankimage" id="ri1">
                    <div class="caption" id="d1">Iron IV</div>
                </span>

                <img src="https://i.imgur.com/nle3vdt.png" class="arrow sameline">

                <span>
                    <img src="https://i.imgur.com/iltHUX5.png" class="rankimage" id="ri2">
                    <div class="caption" id="d2">Iron IV</div>
                </span>
                
            </div>
            <br><br>
            <div class="addinfo" id="adinfo">+4 Wins</div>
        </div>

        <div class="chat">
            <div class="scrollmessages" id="text">
            </div>
            <br style="color: #d29c4b;">
            <form id = "form" class="form" autocomplete="off">
                <input type="text" id="message">
            </form>
        </div>
    </div>


    <script type="module">
        import { io } from "https://cdn.socket.io/4.4.1/socket.io.esm.min.js"
        
        const form = document.getElementById("form")
        const message = document.getElementById("message")
        const text = document.getElementById("text")
        const socket = io.connect("/") // Change this to "https://bobsboosting.com"
        const boostinfo = document.getElementById("boostinfo")
        var val = ""
        var sender = ""
        var prevSender = ""
        var username = '<%-username%>'
        var password = '<%-password%>'
        var usertype = '<%-usertype%>'
        var chat = JSON.parse('<%-chat%>')
        var temp = ""

        var d1 = document.getElementById("d1")
        var d2 = document.getElementById("d2")
        var rimg1 = document.getElementById("ri1")
        var rimg2 = document.getElementById("ri2")
        var adinfo = document.getElementById("adinfo")
        var links = {
            "lIron": 'https://i.imgur.com/Tj2BpH3.png',
            "lBronze": 'https://i.imgur.com/sPrqDTq.png',
            "lSilver": 'https://i.imgur.com/NiCijlD.png',
            "lGold": 'https://i.imgur.com/9wXycG8.png',
            "lPlatinum": 'https://i.imgur.com/z4I2pt9.png',
            "lEmerald": 'https://i.imgur.com/iltHUX5.png',
            "lDiamond": 'https://i.imgur.com/fy4NjAA.png',
            "lMaster": 'https://i.imgur.com/gAhdiIa.png',
            "vIron": 'https://i.imgur.com/LXeIjWK.png',
            "vBronze": 'https://i.imgur.com/CnhEMym.png',
            "vSilver": 'https://i.imgur.com/eZKRCy3.png',
            "vGold": 'https://i.imgur.com/fRClGAd.png',
            "vPlatinum":'https://i.imgur.com/y35FmjI.png',
            "vDiamond":'https://i.imgur.com/F1yuoUM.png',
            "vAscendant":'https://i.imgur.com/WkKkMWr.png',
            "vImmortal": 'https://i.imgur.com/HTJBoBR.png',
            "oBronze": 'https://i.imgur.com/tAGTnxa.png',
            "oSilver": 'https://i.imgur.com/wqWzIMZ.png',
            "oGold": 'https://i.imgur.com/5aLApsB.png',
            "oPlatinum": 'https://i.imgur.com/KctiVAu.png',
            "oDiamond": 'https://i.imgur.com/rGbaSYN.png',
            "oMaster": 'https://i.imgur.com/kl5YjI0.png',
            "oGrandmaster": 'https://i.imgur.com/qdWlM12.png',
        }
        var startR = ""
        var startD = ""
        var endR = ""
        var endD = ""
        var game = "";

        var i

        if (chat.length > 0){
            chat.forEach((element) => {
                console.log(element)
                displayMessage(element.content, element.sender)
            })
        }
        
        socket.emit("authenticate", username, password, usertype)

        form.addEventListener("submit", arg => {
            arg.preventDefault()
            val = message.value
            if (val == ""){
                return
            }
            displayMessage(val, username)
            socket.emit('sendMessage', val)
            form.reset()
        })

        socket.on("receiveMessage", (content, s) =>{
            displayMessage(content, s)
        })

        socket.on("boostdetails", (boost)=>{
            if (boost){
                formatboostinfo(boost)
            }
        })

        function displayMessage(msg, sender){
            if (prevSender != sender){
                text.innerHTML += `<div class='sender'><b>${sender}</b><br></div>`
            }
            text.innerHTML += `<div class='content'>${msg}<br></div>`
            text.scrollBy(0, 100)   
            prevSender = sender 
        }

        function formatboostinfo(boost){
            [startR, startD] = boost.start.split("+");
            [endR, endD] = boost.end.split("+")
            game = boost.game[0]

            console.log(game + startR)
            console.log(game + endR)

            rimg1.src = links[game + startR]
            rimg2.src = links[game + endR]

            d1.innerHTML = startD
            d2.innerHTML = endD

            if (boost.duo == "S"){
                adinfo.innerHTML = "Solo Boost<br>"
            } else{
                adinfo.innerHTML = "Duo Boost<br>"
            }
            adinfo.innerHTML += "Additional wins: " + boost.addwins
        }


    </script>
</body>

</html>
