<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href='https://fonts.googleapis.com/css?family=Dangrek' rel='stylesheet'>
    <link rel="stylesheet" href="/banner.css">
    <link rel="icon" href="https://bobsboosting.com/favicon.ico" type="image/x-icon">
    <link rel="shortcut icon" href="https://bobsboosting.com/favicon.ico" type="image/x-icon">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-L5ELYSX1G0">
    </script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-L5ELYSX1G0');
    </script>
    <title>Bob's Boosting Login</title>

    <style>
        body {
            background-image: url("https://i.imgur.com/s5YamhA.png");
            background-repeat: no-repeat;
            background-attachment: fixed;
            background-size: cover;
        }

        .form {
            text-align: center;
            width: 90%;
            position: relative;
            left: 5%;
        }   

        .form input {
            width: 94%;
            padding: 7px;
            border: 2px solid #d29c4b;
            border-radius: 5px;
            margin: 15px 0px;
            background-color: #04131d;
            color: white;
            font-size: 15px;
        }

        .container {
            position: absolute;
            top:0px;
            left:0px;
            width:100vw;
            height: 100vh;
            color: #d29c4b;
            display: flex;
            text-align: center;
            flex-wrap: wrap;
            justify-content: center;
            font-family: Arial, Helvetica, sans-serif;
        }

        .formcontainer {
            top: 350px;
            position: absolute;
            min-width: 400px;
            min-height: 358px;
            height: 400px;
        }

        .title{
            font-size: 120px;
            margin: 15px;
            font-family: Impact, 'Arial Narrow Bold', sans-serif;
            text-shadow: 3px 3px 0px black;
        }

        .bob{
            background-color: #0f496f;
            border: 3px solid #d29c4b;
            border-radius: 5px; 
            padding: 16px 32px;
            text-decoration: none;
            cursor: pointer;
            margin: 10px;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 17px;
        }

        .info{
            color: white;
        }


    </style>
</head>

<body>

    <div class="container">
        <div class="banner l">
            <a class="nodec" href="https://bobsboosting.com">Home</a> 
            <a class="nodec" href="https://bobsboosting.com/login">Login</a>
            <a class="nodec" href="https://discord.gg/uvJRspbxuB">Discord</a> 
            <a class="nodec" href="https://bobsboosting.com/FAQ">FAQ</a>
        </div>

        <div class="formcontainer">
            <div class="title" id="title">Login</div>
            <div class="info" id="info"></div>
            <form class="form" action="/login" method="post" name="regForm" autocomplete="off" id="form">     
                <div class="form-group">
                    <input type="text" name="username" class="form-control" id="username" placeholder="Username or Email">
                    <input type="text" name="password" class="form-control" id="password" placeholder="Password">
                </div>
                <div id="formerror"></div>
                <button class="bob" type="submit" id="submitbutton"><b><%=formtype%></b></button>
            </form>   
            <div id=disclaimer></div>
            <br><br>
        </div> 
    </div>

    <script>
        var problem = '<%-problem%>'
        var formtype = '<%-formtype%>'
        var orderID = '<%-orderID%>'
        console.log(orderID)
        var changelink = document.getElementById("changelink")
        console.log(formtype)
        if (problem != ""){
            formerror = document.getElementById("formerror").innerHTML = problem
        }
        if (formtype == "Sign up"){
            document.getElementById("form").action = `/signup/${orderID}`
            document.getElementById("title").innerHTML = "Signup"
            document.getElementById("info").innerHTML = "OR <br><br> Use <a href='https://discord.gg/uvJRspbxuB'> Discord </a> chat instead by providing your Order ID: <%=orderID%> <br>"
            document.getElementById("disclaimer").innerHTML = "Sign up with email or remember your Order ID incase you forget your password!"
        }
    </script>
</body>

</html>
